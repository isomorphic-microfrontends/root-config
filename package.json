{
  "type": "module",
  "scripts": {
    "develop": "cross-env NODE_ENV='development' concurrently -n w: 'pnpm:develop:*'",
    "develop:node": "nodemon -e js,ejs,html --import=./server/register-hooks.js ./server/server.js",
    "develop:webpack": "webpack-dev-server --mode=development --port 9876 --env isLocal=true --config webpack.config.cjs",
    "start:node": "node --experimental-loader @node-loader/core server/server.js",
    "test": "jest",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "build": "webpack --mode=production --config webpack.config.cjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-cli": "^30.1.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "pretty-quick": "^4.2.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "dependencies": {
    "@node-loader/http": "^2.0.0",
    "@node-loader/import-maps": "^2.0.0",
    "ejs": "^3.1.3",
    "express": "^5.1.0",
    "import-map-overrides": "^6.1.0",
    "merge2": "^1.4.1",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "parse5": "^8.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "single-spa": "^6.0.3",
    "single-spa-layout": "^3.0.0",
    "single-spa-web-server-utils": "^3.0.0"
  },
  "engines": {
    "node": ">= 24"
  }
}
